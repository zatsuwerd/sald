<div class="main-returns-section py-12 md:py-20 bg-white">
  <div class="page-width mx-auto px-4 md:px-8 max-w-4xl">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-black tracking-wider uppercase bg-rose-50 text-rose-700 border border-rose-200/80 mb-3">
        30 Days Risk-Free
      </span>
      <h1 class="text-3xl md:text-5xl font-black text-slate-900 tracking-tight">
        {{ section.settings.title | default: '30-Day Hassle-Free Returns' }}
      </h1>
      <p class="mt-3 text-slate-600 text-sm md:text-base">
        {{ section.settings.subtitle | default: 'Test our games in your pool or backyard. If you are not delighted, return it with prepaid shipping.' }}
      </p>
    </div>

    <div class="p-8 rounded-3xl bg-slate-50 border border-slate-200/80 space-y-4">
      <h3 class="text-lg font-black text-slate-900">How to Initiate a Return</h3>
      <ol class="list-decimal list-inside text-sm text-slate-700 space-y-2 leading-relaxed">
        <li>Locate your SALD order number from your confirmation email.</li>
        <li>Contact support@sald-outdoors.com with your order number.</li>
        <li>Print the prepaid return shipping label and drop it off at any local postal carrier.</li>
        <li>Refunds process back to your original payment method within 48 hours of return inspection.</li>
      </ol>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Returns Content",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "30-Day Hassle-Free Returns" },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle", "default": "Test our games in your pool or backyard with prepaid return shipping." }
  ]
}
{% endschema %}