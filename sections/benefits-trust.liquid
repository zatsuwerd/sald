<section class="sald-benefits-trust py-16 bg-white" data-section-id="{{ section.id }}">
  <div class="max-w-[var(--page-width)] mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-2xl mx-auto mb-12">
      {%- if section.settings.section_badge != blank -%}
        <span class="inline-block px-3 py-1 rounded-full bg-amber-100 text-amber-900 text-xs font-black uppercase tracking-wider mb-3">
          {{ section.settings.section_badge }}
        </span>
      {%- endif -%}
      <h2 class="text-3xl font-black text-slate-900 tracking-tight">{{ section.settings.heading }}</h2>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
      {%- for block in section.blocks -%}
        <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200/80 text-center flex flex-col items-center hover:border-cyan-400 transition-colors" {{ block.shopify_attributes }}>
          <div class="w-14 h-14 rounded-2xl bg-cyan-100/70 text-cyan-600 flex items-center justify-center mb-4">
            {% render 'icon', name: block.settings.icon %}
          </div>
          <h3 class="text-lg font-bold text-slate-900 mb-2">{{ block.settings.title }}</h3>
          <p class="text-sm text-slate-600 font-medium leading-relaxed">{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Benefits / Trust",
  "settings": [
    {
      "type": "text",
      "id": "section_badge",
      "label": "Small tag",
      "default": "The SALD Standard"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Engineered for Sunshine, Laughter & Long-Lasting Durability"
    }
  ],
  "blocks": [
    {
      "type": "benefit_item",
      "name": "Benefit Block",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "shield-check", "label": "Shield Check (UV/Chlorine Proof)" },
            { "value": "truck", "label": "Truck (Fast Delivery)" },
            { "value": "smile", "label": "Smile (Child Safe)" },
            { "value": "repeat", "label": "Repeat (30-Day Guarantee)" }
          ],
          "default": "shield-check"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "UV & Chlorine Proof"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Made with high-grade, marine-tested polymers that will not fade or crack."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Benefits / Trust",
      "category": "Trust"
    }
  ]
}
{% endschema %}