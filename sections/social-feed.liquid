<div class="social-feed-section py-14 bg-white border-t border-slate-100">
  <div class="page-width mx-auto px-4 md:px-8 max-w-7xl">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-8">
      <div>
        <span class="inline-block text-xs font-black tracking-wider uppercase text-cyan-600 mb-1">
          #SALDFUN COMMUNITY
        </span>
        <h2 class="text-3xl font-extrabold text-slate-900 tracking-tight">
          {{ section.settings.heading | default: 'Join The #SALDfun Community' }}
        </h2>
        <p class="mt-1 text-slate-500 text-sm md:text-base">
          {{ section.settings.subheading | default: 'Tag @sald.outdoor to be featured on our active summer wall' }}
        </p>
      </div>
      <div class="mt-4 md:mt-0">
        <a 
          href="{{ section.settings.instagram_url | default: 'https://instagram.com/sald.outdoor' }}" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full text-sm font-bold text-white bg-slate-900 hover:bg-cyan-600 transition-colors shadow-sm"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
          <span>Follow @sald.outdoor</span>
        </a>
      </div>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <div class="relative group overflow-hidden rounded-2xl aspect-square shadow-sm bg-slate-100">
        <img 
          src="https://images.unsplash.com/photo-1533727937480-da3a97967e95?q=80&w=800&auto=format&fit=crop" 
          alt="Kids playing pool basketball" 
          class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
          loading="lazy"
        >
        <div class="absolute inset-0 bg-slate-950/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center p-4 text-center">
          <p class="text-white text-xs font-bold">"Best pool accessory we bought this summer!" @the_miller_crew</p>
        </div>
      </div>

      <div class="relative group overflow-hidden rounded-2xl aspect-square shadow-sm bg-slate-100">
        <img 
          src="https://images.unsplash.com/photo-1472162072942-cd5147eb3902?q=80&w=800&auto=format&fit=crop" 
          alt="Backyard obstacle course" 
          class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
          loading="lazy"
        >
        <div class="absolute inset-0 bg-slate-950/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center p-4 text-center">
          <p class="text-white text-xs font-bold">"Ninja course keeps all 3 boys active outdoors!" @claire_outdoors</p>
        </div>
      </div>

      <div class="relative group overflow-hidden rounded-2xl aspect-square shadow-sm bg-slate-100">
        <img 
          src="https://images.unsplash.com/photo-1511632765486-a01980e01a18?q=80&w=800&auto=format&fit=crop" 
          alt="Lawn tumble tower tournament" 
          class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
          loading="lazy"
        >
        <div class="absolute inset-0 bg-slate-950/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center p-4 text-center">
          <p class="text-white text-xs font-bold">"Neighborhood barbecue champion!" @brian_grills</p>
        </div>
      </div>

      <div class="relative group overflow-hidden rounded-2xl aspect-square shadow-sm bg-slate-100">
        <img 
          src="https://images.unsplash.com/photo-1544367567-0f2fcb009e0b?q=80&w=800&auto=format&fit=crop" 
          alt="Underwater diving gems game" 
          class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
          loading="lazy"
        >
        <div class="absolute inset-0 bg-slate-950/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center p-4 text-center">
          <p class="text-white text-xs font-bold">"The diving gems are pure magic for swimming practice!" @summer_swims</p>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Social Community Feed",
  "tag": "section",
  "class": "section-social-feed",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join The #SALDfun Community"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Tag @sald.outdoor to be featured on our active summer wall"
    },
    {
      "type": "text",
      "id": "instagram_url",
      "label": "Instagram profile URL",
      "default": "https://instagram.com/sald.outdoor"
    },
    {
      "type": "text",
      "id": "tiktok_url",
      "label": "TikTok profile URL",
      "default": "https://tiktok.com/@sald_fun"
    }
  ],
  "presets": [
    {
      "name": "Social Community Feed"
    }
  ]
}
{% endschema %}