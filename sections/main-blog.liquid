<div class="main-blog-section py-12 md:py-16 bg-white min-h-[60vh]">
  <div class="page-width mx-auto px-4 md:px-8 max-w-7xl">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <span class="text-xs font-black uppercase tracking-wider text-cyan-600 block mb-1">SALD OUTDOOR JOURNAL</span>
      <h1 class="text-3xl md:text-5xl font-black text-slate-900 tracking-tight">{{ blog.title }}</h1>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {%- for article in blog.articles -%}
        <article class="rounded-2xl overflow-hidden bg-surface border border-slate-200 shadow-sm flex flex-col">
          {%- if article.image -%}
            <div class="aspect-video overflow-hidden">
              <img src="{{ article.image | image_url: width: 600 }}" alt="{{ article.title | escape }}" class="w-full h-full object-cover">
            </div>
          {%- endif -%}
          <div class="p-6 flex-1 flex flex-col justify-between">
            <div>
              <p class="text-xs text-slate-400 mb-2">{{ article.published_at | date: "%B %d, %Y" }}</p>
              <h2 class="text-xl font-bold text-slate-900 hover:text-cyan-600 transition-colors">
                <a href="{{ article.url }}">{{ article.title }}</a>
              </h2>
              <p class="text-slate-600 text-sm mt-3 line-clamp-3">{{ article.excerpt_or_content | strip_html | truncatewords: 24 }}</p>
            </div>
            <a href="{{ article.url }}" class="inline-block mt-4 text-cyan-600 font-bold text-sm hover:underline">Read Article &rarr;</a>
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Blog Posts",
  "tag": "section",
  "class": "section-main-blog",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Show article image",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show publish date",
      "default": true
    }
  ]
}
{% endschema %}