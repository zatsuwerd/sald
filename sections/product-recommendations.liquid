<div class="product-recommendations-section py-14 bg-surface border-t border-slate-200" data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.products_to_show | default: 4 }}">
  <div class="page-width mx-auto px-4 md:px-8 max-w-7xl">
    {%- if recommendations.performed and recommendations.products_count > 0 -%}
      <div class="mb-8">
        <span class="text-xs font-black uppercase tracking-wider text-cyan-600 block mb-1">
          {{ 'products.product.pairs_well_with' | t | default: 'COMPLETE THE FUN' }}
        </span>
        <h2 class="text-2xl md:text-3xl font-extrabold text-slate-900 tracking-tight">
          {{ section.settings.heading | default: 'Frequently Paired Outdoor Games' }}
        </h2>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">
        {%- for recommendation in recommendations.products -%}
          {% render 'product-card', product: recommendation %}
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="mb-8">
        <h2 class="text-2xl md:text-3xl font-extrabold text-slate-900 tracking-tight">
          {{ section.settings.heading | default: 'Frequently Paired Outdoor Games' }}
        </h2>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">
        {%- for prod in collections.all.products limit: 4 -%}
          {% render 'product-card', product: prod %}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Product Recommendations",
  "tag": "section",
  "class": "section-product-recommendations",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Paired Outdoor Games"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Products to show",
      "default": 4
    }
  ]
}
{% endschema %}