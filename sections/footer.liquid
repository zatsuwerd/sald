<footer class="sald-footer bg-slate-900 text-slate-300 pt-16 pb-12 border-t border-slate-800" data-section-id="{{ section.id }}">
  <div class="max-w-[var(--page-width)] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 pb-12 border-b border-slate-800">
      
      <!-- Col 1: Brand Info -->
      <div class="lg:col-span-2">
        <div class="flex items-center gap-2 mb-4">
          <svg class="h-9 w-auto" viewBox="0 0 320 80" fill="none">
            <g transform="translate(10, 10)">
              <path d="M 6 48 C 16 52, 28 52, 40 47 C 48 43, 56 46, 62 48" stroke="#00D2DF" stroke-width="4.5" stroke-linecap="round" fill="none"/>
              <circle cx="12" cy="18" r="4.5" fill="#00D2DF" />
              <circle cx="35" cy="18" r="7.5" fill="#FFD000"/>
              <path d="M 18 42 C 16 26, 26 22, 34 29 C 40 34, 46 22, 54 28 C 58 31, 56 42, 38 42 Z" fill="#00D2DF"/>
            </g>
            <text x="82" y="55" font-family="'Plus Jakarta Sans', system-ui, sans-serif" font-weight="900" font-size="46" fill="#FFFFFF">S</text>
            <text x="114" y="55" font-family="'Plus Jakarta Sans', system-ui, sans-serif" font-weight="900" font-size="46" fill="#FFFFFF">A</text>
            <circle cx="130" cy="39" r="3.5" fill="#FFD000"/>
            <text x="150" y="55" font-family="'Plus Jakarta Sans', system-ui, sans-serif" font-weight="900" font-size="46" fill="#00C2CB">L</text>
            <text x="180" y="55" font-family="'Plus Jakarta Sans', system-ui, sans-serif" font-weight="900" font-size="46" fill="#FFFFFF">D</text>
          </svg>
        </div>
        <p class="text-sm text-slate-400 font-normal leading-relaxed max-w-sm mb-6">
          SALD creates high-performance outdoor recreation gear, pool accessories, and garden games designed to bring families, friends, and kids together under the sun.
        </p>
        <div class="flex items-center gap-3">
          {% render 'social-icons' %}
        </div>
      </div>

      <!-- Col 2: Shop Menu -->
      <div>
        <h4 class="text-xs font-black uppercase tracking-wider text-cyan-400 mb-4">Shop Outdoor</h4>
        <ul class="space-y-2.5 text-sm font-medium">
          <li><a href="/collections/pool-games" class="hover:text-white transition-colors">Pool Games &amp; Hoops</a></li>
          <li><a href="/collections/playground" class="hover:text-white transition-colors">Playground &amp; Swings</a></li>
          <li><a href="/collections/garden-games" class="hover:text-white transition-colors">Garden Games</a></li>
          <li><a href="/collections/family-games" class="hover:text-white transition-colors">Family Fun Sets</a></li>
          <li><a href="/collections/new-arrivals" class="hover:text-white transition-colors">New Summer Arrivals</a></li>
        </ul>
      </div>

      <!-- Col 3: Customer Care -->
      <div>
        <h4 class="text-xs font-black uppercase tracking-wider text-cyan-400 mb-4">Customer Care</h4>
        <ul class="space-y-2.5 text-sm font-medium">
          <li><a href="/pages/shipping-info" class="hover:text-white transition-colors">Shipping &amp; Delivery</a></li>
          <li><a href="/pages/returns" class="hover:text-white transition-colors">30-Day Splash Returns</a></li>
          <li><a href="/pages/faq" class="hover:text-white transition-colors">Frequently Asked Questions</a></li>
          <li><a href="/pages/contact" class="hover:text-white transition-colors">Contact Support</a></li>
          <li><a href="/pages/warranty" class="hover:text-white transition-colors">Chlorine &amp; UV Warranty</a></li>
        </ul>
      </div>

      <!-- Col 4: Newsletter Box -->
      <div>
        <h4 class="text-xs font-black uppercase tracking-wider text-amber-400 mb-4">Join Club SALD</h4>
        <p class="text-xs text-slate-400 mb-3">Get 15% off your first outdoor order and exclusive backyard game rules.</p>
        <form class="space-y-2">
          <input type="email" placeholder="Your email address" class="w-full px-3.5 py-2.5 text-xs bg-slate-800 border border-slate-700 rounded-xl text-white placeholder-slate-500 focus:outline-none focus:border-cyan-400">
          <button type="submit" class="w-full py-2.5 bg-cyan-500 hover:bg-cyan-600 text-white font-extrabold text-xs rounded-xl transition-colors">Subscribe</button>
        </form>
      </div>

    </div>

    <!-- Bottom copyright + payment icons -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 gap-4">
      <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved. Built with pride for endless sunshine.</p>
      <div class="flex items-center gap-3">
        <span class="text-slate-400 font-medium">Supported: Apple Pay · Visa · Mastercard · PayPal · Shop Pay</span>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    }
  ]
}
{% endschema %}