<div class="main-list-collections py-12 md:py-16 bg-white min-h-[60vh]">
  <div class="page-width mx-auto px-4 md:px-8 max-w-7xl">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <span class="text-xs font-black uppercase tracking-wider text-cyan-600 block mb-1">
        CATEGORIES &amp; EXPEDITIONS
      </span>
      <h1 class="text-3xl md:text-5xl font-black text-slate-900 tracking-tight">
        {{ section.settings.title | default: 'All Collections' }}
      </h1>
      <p class="mt-3 text-slate-600 text-base">
        Explore every department engineered for family active fun under the sun
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {%- for collection in collections -%}
        {%- unless collection.handle == 'frontpage' -%}
          <a href="{{ collection.url }}" class="group block rounded-2xl overflow-hidden bg-surface border border-slate-200 hover:border-cyan-400 shadow-sm transition-all hover:-translate-y-1">
            <div class="aspect-square bg-slate-100 overflow-hidden">
              {%- if collection.featured_image -%}
                <img src="{{ collection.featured_image | image_url: width: 600 }}" alt="{{ collection.title | escape }}" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy">
              {%- else -%}
                <div class="w-full h-full flex items-center justify-center bg-cyan-50 text-cyan-600 font-black text-4xl">
                  SALD
                </div>
              {%- endif -%}
            </div>
            <div class="p-5 text-center">
              <h2 class="text-lg font-bold text-slate-900 group-hover:text-cyan-600 transition-colors">
                {{ collection.title }}
              </h2>
              <p class="text-xs text-slate-500 mt-1">
                {{ collection.all_products_count }} {{ 'sections.collection.products' | t | default: 'products' }}
              </p>
            </div>
          </a>
        {%- endunless -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Collections List",
  "tag": "section",
  "class": "section-main-list-collections",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "All Collections"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Desktop columns",
      "default": 4
    }
  ]
}
{% endschema %}