{%- liquid
  assign header_bg = settings.header_bg_color | default: section.settings.header_bg_color | default: '#FFFFFF'
  assign header_text = settings.header_text_color | default: section.settings.header_text_color | default: '#0F172A'
  assign is_sticky = settings.header_sticky
  if is_sticky == nil
    assign is_sticky = section.settings.sticky_header
  endif
  if is_sticky == nil
    assign is_sticky = true
  endif
  assign header_layout = settings.header_layout | default: section.settings.layout | default: 'logo_left_menu_center'
  assign show_border = settings.header_border_bottom
  if show_border == nil
    assign show_border = section.settings.show_border_bottom
  endif
  if show_border == nil
    assign show_border = true
  endif
  assign show_search = settings.header_show_search
  if show_search == nil
    assign show_search = section.settings.show_search
  endif
  if show_search == nil
    assign show_search = true
  endif
  assign show_cart_badge = settings.header_show_cart_count
  if show_cart_badge == nil
    assign show_cart_badge = section.settings.show_cart_badge
  endif
  if show_cart_badge == nil
    assign show_cart_badge = true
  endif
  assign is_transparent_home = settings.header_transparent_home | default: false
  assign drawer_style = settings.header_drawer_style | default: 'glassmorphism'
-%}

{%- style -%}
  :root {
    --header-bg: {{ header_bg }};
    --header-text: {{ header_text }};
  }
  .sald-header {
    background-color: var(--header-bg);
    color: var(--header-text);
  }
  .sald-header a, .sald-header button {
    color: var(--header-text);
  }
  .sald-header.is-transparent-home {
    background-color: transparent !important;
    border-color: rgba(255, 255, 255, 0.15) !important;
    color: #FFFFFF !important;
    position: absolute !important;
    top: 0;
    left: 0;
    right: 0;
    z-index: 40;
  }
  .sald-header.is-transparent-home a,
  .sald-header.is-transparent-home button {
    color: #FFFFFF !important;
  }
  .sald-header .header-brand-logo {
    width: {{ settings.logo_width_mobile | default: 110 }}px;
  }
  @media screen and (min-width: 1024px) {
    .sald-header .header-brand-logo {
      width: {{ settings.logo_width | default: 140 }}px;
    }
  }
{%- endstyle -%}

<header class="sald-header {% if is_sticky %}sticky top-0{% else %}relative{% endif %} {% if is_transparent_home and template.name == 'index' %}is-transparent-home{% endif %} z-40 backdrop-blur-md {% if show_border %}border-b border-slate-200/80{% endif %} transition-all duration-200" data-header>
  <div class="max-w-[var(--page-width)] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20 gap-4">
      
      <!-- Mobile Hamburger Button -->
      <div class="flex items-center lg:hidden">
        <button type="button" class="p-2 -m-2 hover:text-cyan-600 focus:outline-none focus:ring-2 focus:ring-cyan-500 rounded-lg" data-mobile-menu-open aria-label="{{ 'header.menu' | t }}">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/></svg>
        </button>
      </div>

      <!-- Brand Logo -->
      <div class="flex-shrink-0 flex items-center {% if header_layout contains 'logo_center' %}lg:order-2{% endif %}">
        <a href="{{ routes.root_url }}" class="inline-flex items-center group" aria-label="{{ shop.name }}">
          {%- if is_transparent_home and template.name == 'index' and settings.logo_transparent != blank -%}
            <img src="{{ settings.logo_transparent | image_url: width: 300 }}" 
                 alt="{{ shop.name }}" 
                 class="header-brand-logo h-auto object-contain transition-transform group-hover:scale-[1.02]"
                 loading="eager" width="{{ settings.logo_width | default: 140 }}" height="50">
          {%- elsif settings.logo != blank -%}
            <img src="{{ settings.logo | image_url: width: 300 }}" 
                 alt="{{ shop.name }}" 
                 class="header-brand-logo h-auto object-contain transition-transform group-hover:scale-[1.02]"
                 loading="eager" width="{{ settings.logo_width | default: 140 }}" height="50">
          {%- else -%}
            <!-- Native SALD Branded SVG Logo Fallback -->
            <div class="flex items-center gap-2 header-brand-logo">
              <svg class="h-10 w-auto" width="160" height="40" viewBox="0 0 320 80" fill="none">
                <defs>
                  <linearGradient id="saldAquaH" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#00D2DF"/><stop offset="100%" stop-color="#00A2B3"/></linearGradient>
                  <linearGradient id="saldSunH" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#FFD000"/><stop offset="100%" stop-color="#F59E0B"/></linearGradient>
                </defs>
                <g transform="translate(10, 10)">
                  <path d="M 6 48 C 16 52, 28 52, 40 47 C 48 43, 56 46, 62 48" stroke="#00D2DF" stroke-width="4.5" stroke-linecap="round" fill="none"/>
                  <circle cx="12" cy="18" r="4.5" fill="url(#saldAquaH)" />
                  <circle cx="26" cy="10" r="3.5" fill="url(#saldSunH)" />
                  <path d="M 18 42 C 16 26, 26 22, 34 29 C 40 34, 46 22, 54 28 C 58 31, 56 42, 38 42 Z" fill="url(#saldAquaH)"/>
                  <circle cx="35" cy="18" r="7.5" fill="url(#saldSunH)"/>
                </g>
                <text x="82" y="55" font-family="'Plus Jakarta Sans', system-ui, sans-serif" font-weight="900" font-size="46" fill="currentColor" letter-spacing="-1">S</text>
                <text x="114" y="55" font-family="'Plus Jakarta Sans', system-ui, sans-serif" font-weight="900" font-size="46" fill="currentColor" letter-spacing="-1">A</text>
                <circle cx="130" cy="39" r="3.5" fill="url(#saldSunH)"/>
                <text x="150" y="55" font-family="'Plus Jakarta Sans', system-ui, sans-serif" font-weight="900" font-size="46" fill="#00C2CB" letter-spacing="-1">L</text>
                <text x="180" y="55" font-family="'Plus Jakarta Sans', system-ui, sans-serif" font-weight="900" font-size="46" fill="currentColor" letter-spacing="-1">D</text>
                <text x="84" y="70" font-family="'Plus Jakarta Sans', system-ui, sans-serif" font-weight="700" font-size="9" fill="#00A2B3" letter-spacing="3.2">OUTDOOR &amp; POOL FUN</text>
              </svg>
            </div>
          {%- endif -%}
        </a>
      </div>

      <!-- Desktop Primary Navigation + Mega Menu -->
      <nav class="hidden lg:flex items-center gap-7 {% if header_layout contains 'logo_center' %}lg:order-1{% endif %}" aria-label="Main Navigation">
        {%- if linklists[section.settings.menu].links.size > 0 -%}
          {%- for link in linklists[section.settings.menu].links -%}
            <a href="{{ link.url }}" class="text-sm font-bold hover:text-cyan-500 py-3 transition-colors">
              {{ link.title }}
            </a>
          {%- endfor -%}
        {%- else -%}
          <div class="relative group">
            <a href="{{ routes.all_products_collection_url | default: '/collections/all' }}" class="text-sm font-bold hover:text-cyan-500 py-3 inline-flex items-center gap-1 transition-colors">
              <span>Pool Games</span>
              <svg class="w-4 h-4 opacity-70 group-hover:text-cyan-500 transition-transform group-hover:rotate-180" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
            </a>
            <!-- Mega Menu Dropdown -->
            <div class="absolute left-0 top-full pt-2 opacity-0 translate-y-2 pointer-events-none group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto transition-all duration-200 z-50">
              <div class="bg-white text-slate-800 rounded-2xl shadow-xl border border-slate-100 p-6 w-[560px] grid grid-cols-2 gap-6">
                <div>
                  <h4 class="text-xs font-extrabold uppercase tracking-wider text-cyan-600 mb-3">Popular Pool Gear</h4>
                  <ul class="space-y-2.5 text-sm font-medium text-slate-600">
                    <li><a href="{{ routes.all_products_collection_url | default: '/collections/all' }}" class="hover:text-cyan-600 flex items-center justify-between"><span>Floating Slam Basketball</span><span class="text-[10px] bg-amber-100 text-amber-800 font-bold px-1.5 py-0.5 rounded">Hot</span></a></li>
                    <li><a href="{{ routes.all_products_collection_url | default: '/collections/all' }}" class="hover:text-cyan-600">Cross-Pool Volleyball Nets</a></li>
                    <li><a href="{{ routes.all_products_collection_url | default: '/collections/all' }}" class="hover:text-cyan-600">Glow Diving Rings &amp; Torpedoes</a></li>
                    <li><a href="{{ routes.all_products_collection_url | default: '/collections/all' }}" class="hover:text-cyan-600">Commercial Grade Floats</a></li>
                  </ul>
                </div>
                <div class="bg-cyan-50/70 rounded-xl p-4 border border-cyan-100 flex flex-col justify-between">
                  <div>
                    <span class="text-[10px] uppercase font-bold tracking-widest text-cyan-800">Bundle &amp; Save</span>
                    <p class="font-bold text-slate-900 mt-1">Pool Party Starter Pack</p>
                    <p class="text-xs text-slate-600 mt-1">Includes hoop, floating net, 4 balls &amp; hand pump.</p>
                  </div>
                  <a href="{{ routes.all_products_collection_url | default: '/collections/all' }}" class="mt-3 text-xs font-bold text-cyan-600 inline-flex items-center gap-1 hover:underline">Shop Now &rarr;</a>
                </div>
              </div>
            </div>
          </div>

          <a href="{{ routes.all_products_collection_url | default: '/collections/all' }}" class="text-sm font-bold hover:text-cyan-500 py-3 transition-colors">Playground</a>
          <a href="{{ routes.all_products_collection_url | default: '/collections/all' }}" class="text-sm font-bold hover:text-cyan-500 py-3 transition-colors">Garden Games</a>
          <a href="{{ routes.all_products_collection_url | default: '/collections/all' }}" class="text-sm font-bold hover:text-cyan-500 py-3 transition-colors">Family Fun</a>
          <a href="{{ routes.all_products_collection_url | default: '/collections/all' }}" class="text-sm font-bold hover:text-cyan-500 py-3 transition-colors">All Products</a>
          <a href="/pages/about-us" class="text-sm font-bold hover:text-cyan-500 py-3 transition-colors">About Us</a>
          <a href="/pages/faq" class="text-sm font-bold hover:text-cyan-500 py-3 transition-colors">FAQs</a>
          <a href="/pages/contact" class="text-sm font-bold hover:text-cyan-500 py-3 transition-colors">Contact</a>
        {%- endif -%}
      </nav>

      <!-- Right Header Actions (Search, Account, Language, Cart Drawer) -->
      <div class="flex items-center gap-2 sm:gap-3 lg:order-3">
        <!-- Language Switcher Form -->
        {%- if localization.available_languages.size > 1 -%}
          <div class="localization-switcher hidden sm:inline-flex items-center">
            {%- form 'localization', id: 'HeaderLanguageForm' -%}
              <input type="hidden" name="locale_code" value="{{ localization.language.iso_code }}">
              <div class="inline-flex items-center p-0.5 rounded-full bg-slate-100 border border-slate-200 text-xs font-bold">
                {%- for language in localization.available_languages -%}
                  <button type="submit" name="locale_code" value="{{ language.iso_code }}"
                          class="px-2.5 py-1 rounded-full text-xs font-bold transition-all {% if language.iso_code == localization.language.iso_code %}bg-white text-slate-900 shadow-sm border border-slate-200/60{% else %}text-slate-600 hover:text-slate-900{% endif %}">
                    {{ language.endonym_name | capitalize }}
                  </button>
                {%- endfor -%}
              </div>
            {%- endform -%}
          </div>
        {%- endif -%}

        <!-- Search Button -->
        {%- if show_search -%}
          <button type="button" class="p-2 hover:text-cyan-500 rounded-full hover:bg-black/5 transition-colors" data-search-open aria-label="{{ 'header.search' | t }}">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          </button>
        {%- endif -%}

        <!-- Account -->
        {%- if shop.customer_accounts_enabled -%}
          <a href="{{ routes.account_url }}" class="hidden sm:inline-flex p-2 hover:text-cyan-500 rounded-full hover:bg-black/5 transition-colors" aria-label="{{ 'header.account' | t }}">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
          </a>
        {%- endif -%}

        <!-- Cart Trigger Button -->
        <button type="button" class="relative p-2.5 hover:text-cyan-500 rounded-full hover:bg-black/5 transition-colors" data-cart-open aria-label="{{ 'header.cart' | t }}">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
          {%- if show_cart_badge -%}
            <span class="absolute -top-0.5 -right-0.5 bg-cyan-500 text-white font-extrabold text-[11px] h-5 min-w-[20px] px-1 rounded-full flex items-center justify-center border-2 border-white shadow-sm" data-cart-count>
              {{ cart.item_count | default: 0 }}
            </span>
          {%- endif -%}
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Drawer with Full View Glassmorphism Effect -->
  <div id="MobileMenuDrawer" class="hidden fixed inset-0 z-[99999] lg:hidden w-screen h-[100dvh] overflow-hidden" role="dialog" aria-modal="true" aria-label="Mobile Navigation">
    <div class="fixed inset-0 bg-slate-950/65 backdrop-blur-md transition-opacity duration-300" data-mobile-menu-close></div>

    <div class="fixed inset-y-0 left-0 rtl:left-auto rtl:right-0 w-full sm:max-w-md {% if drawer_style == 'frosted' %}bg-white/95 backdrop-blur-md shadow-xl border-r border-slate-200/80{% elsif drawer_style == 'solid' %}bg-white shadow-lg border-r border-slate-200{% else %}bg-white/90 backdrop-blur-2xl border-r rtl:border-r-0 rtl:border-l border-white/40 shadow-2xl{% endif %} z-10 flex flex-col h-[100dvh] max-h-[100dvh] overflow-hidden" data-mobile-menu-panel>
      
      <!-- Drawer Header Bar -->
      <div class="relative z-10 flex items-center justify-between px-5 py-4 border-b border-slate-200/80 bg-white/80 backdrop-blur-md flex-shrink-0">
        <a href="{{ routes.root_url }}" class="flex items-center gap-2">
          <span class="text-2xl font-black tracking-tight text-slate-900">SALD</span>
          <span class="text-[10px] uppercase font-black tracking-widest px-2.5 py-0.5 rounded-full bg-cyan-500/15 text-cyan-800 border border-cyan-400/30">
            Outdoor Fun
          </span>
        </a>
        <button type="button" class="w-10 h-10 rounded-full flex items-center justify-center text-slate-600 hover:bg-slate-100" data-mobile-menu-close aria-label="Close menu">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>

      <!-- Scrollable Drawer Body -->
      <div class="relative z-10 flex-1 overflow-y-auto px-5 py-4 space-y-5">
        <button type="button" class="w-full flex items-center gap-3 px-4 py-3 rounded-2xl bg-slate-50 border border-slate-200 text-slate-600 text-xs font-bold text-left rtl:text-right" data-search-open>
          <svg class="w-4 h-4 text-cyan-600" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          <span>{{ 'general.search' | t | default: 'Search pool games, floats, nets...' }}</span>
        </button>

        <div>
          <span class="text-[10px] font-black uppercase tracking-wider text-slate-400 block mb-2 px-1">
            Collections
          </span>
          <nav class="space-y-2 font-bold text-slate-800 text-sm">
            <a href="{{ routes.all_products_collection_url | default: '/collections/all' }}" class="flex items-center justify-between px-4 py-3 rounded-2xl bg-white border border-slate-200 shadow-sm">
              <span>Pool Games &amp; Floats</span>
              <span class="text-[10px] bg-amber-100 text-amber-900 px-2 py-0.5 rounded-full font-bold">Hot</span>
            </a>
            <a href="{{ routes.all_products_collection_url | default: '/collections/all' }}" class="flex items-center justify-between px-4 py-3 rounded-2xl bg-white border border-slate-200 shadow-sm">
              <span>Playground &amp; Swings</span>
              <svg class="w-4 h-4 text-slate-400 rtl:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
            </a>
            <a href="{{ routes.all_products_collection_url | default: '/collections/all' }}" class="flex items-center justify-between px-4 py-3 rounded-2xl bg-white border border-slate-200 shadow-sm">
              <span>Garden Games &amp; Cornhole</span>
              <svg class="w-4 h-4 text-slate-400 rtl:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
            </a>
            <a href="{{ routes.all_products_collection_url | default: '/collections/all' }}" class="flex items-center justify-between px-4 py-3 rounded-2xl bg-white border border-slate-200 shadow-sm">
              <span>Family &amp; Party Games</span>
              <svg class="w-4 h-4 text-slate-400 rtl:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
            </a>
            <a href="{{ routes.all_products_collection_url | default: '/collections/all' }}" class="flex items-center justify-between px-4 py-3 rounded-2xl bg-cyan-50 border border-cyan-200 text-cyan-900">
              <span>View All Products</span>
              <svg class="w-4 h-4 text-cyan-600 rtl:rotate-180" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
            </a>
          </nav>
        </div>

        <div class="pt-3 border-t border-slate-200">
          <span class="text-[10px] font-black uppercase tracking-wider text-slate-400 block mb-2 px-1">
            Store Info
          </span>
          <div class="rounded-2xl bg-slate-50 border border-slate-200 p-2 space-y-1 text-xs font-bold text-slate-700">
            <a href="/pages/about-us" class="block px-3 py-2 rounded-xl hover:bg-white">About Us (Our Story)</a>
            <a href="/pages/faq" class="block px-3 py-2 rounded-xl hover:bg-white">Help &amp; FAQs</a>
            <a href="/pages/contact" class="block px-3 py-2 rounded-xl hover:bg-white">Contact Support</a>
            <a href="/pages/shipping-policy" class="block px-3 py-2 rounded-xl hover:bg-white">Shipping &amp; 30-Day Guarantee</a>
          </div>
        </div>
      </div>

      <!-- Drawer Footer -->
      <div class="p-4 border-t border-slate-200 bg-white/80">
        <button type="button" class="w-full flex items-center justify-between p-3.5 rounded-2xl bg-cyan-500 text-white font-bold text-xs shadow-md" data-cart-open>
          <span>{{ 'header.cart' | t | default: 'Shopping Cart' }}</span>
          <span class="bg-white/20 px-2.5 py-0.5 rounded-full" data-cart-count>{{ cart.item_count | default: 0 }}</span>
        </button>
      </div>

    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "header",
      "content": "Layout & Positioning"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Header layout",
      "options": [
        { "value": "logo_left_menu_center", "label": "Logo Left, Menu Center" },
        { "value": "logo_left_menu_left", "label": "Logo Left, Menu Left" },
        { "value": "logo_center_menu_split", "label": "Logo Center, Menu Split" }
      ],
      "default": "logo_left_menu_center"
    },
    {
      "type": "checkbox",
      "id": "sticky_header",
      "label": "Enable sticky header on scroll",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_border_bottom",
      "label": "Show bottom border divider",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "header_bg_color",
      "label": "Header background color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "header_text_color",
      "label": "Header text and icon color",
      "default": "#0F172A"
    },
    {
      "type": "header",
      "content": "Navigation & Actions"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Primary navigation menu",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show search bar trigger",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_cart_badge",
      "label": "Show cart count badge",
      "default": true
    }
  ]
}
{% endschema %}
