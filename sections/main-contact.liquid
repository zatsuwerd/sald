<div class="main-contact-section py-12 md:py-20 bg-white">
  <div class="page-width mx-auto px-4 md:px-8 max-w-4xl">
    
    <div class="text-center max-w-2xl mx-auto mb-12">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-black tracking-wider uppercase bg-cyan-50 text-cyan-700 border border-cyan-200/80 mb-3">
        Customer Care &amp; Support
      </span>
      <h1 class="text-3xl md:text-5xl font-black text-slate-900 tracking-tight">
        {{ section.settings.title | default: "We'd Love to Hear From You" }}
      </h1>
      <p class="mt-3 text-slate-600 text-sm md:text-base">
        {{ section.settings.subtitle | default: "Questions about orders, pool dimensions, or warranty? Our support crew replies within 24 hours." }}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
      <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200/70 text-center">
        <p class="text-xs uppercase font-extrabold tracking-wider text-slate-400 mb-1">Email Us</p>
        <p class="text-sm font-black text-slate-900">support@sald-outdoor.com</p>
        <p class="text-xs text-slate-500 mt-1">24/7 inbox support</p>
      </div>
      <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200/70 text-center">
        <p class="text-xs uppercase font-extrabold tracking-wider text-slate-400 mb-1">Phone &amp; WhatsApp</p>
        <p class="text-sm font-black text-slate-900">+1 (800) 555-SALD</p>
        <p class="text-xs text-slate-500 mt-1">Mon - Sat, 9am - 6pm EST</p>
      </div>
      <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200/70 text-center">
        <p class="text-xs uppercase font-extrabold tracking-wider text-slate-400 mb-1">Dispatch Hub</p>
        <p class="text-sm font-black text-slate-900">Miami, FL &amp; Dubai, UAE</p>
        <p class="text-xs text-slate-500 mt-1">Fast 48-hr courier dispatch</p>
      </div>
    </div>

    <!-- Native Shopify Contact Form -->
    <div class="bg-white rounded-3xl border border-slate-200 p-6 md:p-10 shadow-lg">
      {% form 'contact', id: 'ContactForm' %}
        {%- if form.posted_successfully? -%}
          <div class="p-4 mb-6 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm font-bold flex items-center gap-2">
            <span>✓</span>
            <span>Thank you! Your message has been sent successfully. We will get back to you shortly.</span>
          </div>
        {%- elsif form.errors -%}
          <div class="p-4 mb-6 rounded-2xl bg-rose-50 border border-rose-200 text-rose-800 text-sm font-bold">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 mb-5">
          <div>
            <label for="ContactForm-name" class="block text-xs font-black uppercase tracking-wider text-slate-700 mb-1.5">
              Full Name *
            </label>
            <input 
              type="text" 
              name="contact[name]" 
              id="ContactForm-name" 
              required
              class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:outline-none focus:border-cyan-500 focus:ring-2 focus:ring-cyan-200 text-sm" 
              placeholder="e.g. Sarah Miller"
            >
          </div>
          <div>
            <label for="ContactForm-email" class="block text-xs font-black uppercase tracking-wider text-slate-700 mb-1.5">
              Email Address *
            </label>
            <input 
              type="email" 
              name="contact[email]" 
              id="ContactForm-email" 
              required
              class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:outline-none focus:border-cyan-500 focus:ring-2 focus:ring-cyan-200 text-sm" 
              placeholder="sarah@example.com"
            >
          </div>
        </div>

        <div class="mb-5">
          <label for="ContactForm-subject" class="block text-xs font-black uppercase tracking-wider text-slate-700 mb-1.5">
            Subject / Topic
          </label>
          <input 
            type="text" 
            name="contact[subject]" 
            id="ContactForm-subject" 
            class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:outline-none focus:border-cyan-500 focus:ring-2 focus:ring-cyan-200 text-sm" 
            placeholder="Order tracking, product inquiry, or warranty question"
          >
        </div>

        <div class="mb-6">
          <label for="ContactForm-body" class="block text-xs font-black uppercase tracking-wider text-slate-700 mb-1.5">
            Your Message *
          </label>
          <textarea 
            rows="5" 
            name="contact[body]" 
            id="ContactForm-body" 
            required
            class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:outline-none focus:border-cyan-500 focus:ring-2 focus:ring-cyan-200 text-sm" 
            placeholder="How can we assist you today?"
          ></textarea>
        </div>

        <button 
          type="submit" 
          class="w-full py-4 rounded-xl bg-cyan-500 hover:bg-cyan-600 text-white font-extrabold text-sm transition-all shadow-md active:scale-95"
        >
          Send Message
        </button>
      {% endform %}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Contact Page Form",
  "tag": "section",
  "class": "section-main-contact",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "We'd Love to Hear From You"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Questions about orders, pool dimensions, or warranty? Our support crew replies within 24 hours."
    }
  ]
}
{% endschema %}