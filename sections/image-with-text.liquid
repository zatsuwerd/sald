<section class="sald-image-with-text py-16 lg:py-24 bg-white border-t border-slate-100" data-section-id="{{ section.id }}">
  <div class="max-w-[var(--page-width)] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center {% if section.settings.layout == 'image_second' %}lg:grid-flow-dense{% endif %}">
      
      <!-- Visual Column -->
      <div class="{% if section.settings.layout == 'image_second' %}lg:col-start-2{% endif %}">
        <div class="relative rounded-3xl overflow-hidden shadow-2xl bg-cyan-900 border-4 border-white aspect-[4/3]">
          {%- if section.settings.image != blank -%}
            <img src="{{ section.settings.image | image_url: width: 1200 }}" 
                 alt="{{ section.settings.heading | escape }}" 
                 class="w-full h-full object-cover" 
                 loading="lazy" width="1200" height="900">
          {%- else -%}
            <!-- Stylized Outdoor Fun Action Graphic -->
            <div class="absolute inset-0 bg-gradient-to-tr from-cyan-900 via-slate-900 to-cyan-600 flex flex-col justify-end p-8 text-white">
              <span class="text-amber-400 font-black text-xs uppercase tracking-widest mb-2">Built for Endless Sunshine</span>
              <h3 class="text-2xl font-black">Backyard memories that last a lifetime</h3>
              <p class="text-xs text-slate-300 mt-2">Zero screens. 100% active laughter and water games.</p>
            </div>
          {%- endif -%}
        </div>
      </div>

      <!-- Text Column -->
      <div class="{% if section.settings.layout == 'image_second' %}lg:col-start-1{% endif %}">
        {%- if section.settings.eyebrow != blank -%}
          <span class="text-xs font-black uppercase tracking-wider text-cyan-600 mb-3 block">
            {{ section.settings.eyebrow }}
          </span>
        {%- endif -%}

        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 tracking-tight leading-tight mb-6">
          {{ section.settings.heading }}
        </h2>

        <div class="prose prose-slate text-base sm:text-lg text-slate-600 leading-relaxed space-y-4 mb-8">
          <p>{{ section.settings.text }}</p>
        </div>

        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link | default: '/collections/all' }}" 
             class="inline-flex items-center justify-center px-8 py-4 bg-slate-900 hover:bg-cyan-600 text-white font-extrabold text-sm rounded-full shadow-md transition-colors">
            {{ section.settings.button_label }}
            <svg class="w-4 h-4 ml-2 rtl:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        {%- endif -%}
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image with text",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Desktop image alignment",
      "options": [
        { "value": "image_first", "label": "Image on left" },
        { "value": "image_second", "label": "Image on right" }
      ],
      "default": "image_first"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow tag",
      "default": "UNPLUG THE SCREENS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Turn Your Backyard into the Ultimate Adventure Park"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "At SALD, we believe the best childhood memories happen outdoors under the sun with wet hair, bare feet, and contagious laughter. Every piece of equipment is designed for rapid 5-minute setup and years of active play."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Discover the SALD Story"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Image with text",
      "category": "Story"
    }
  ]
}
{% endschema %}