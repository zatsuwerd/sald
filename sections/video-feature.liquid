{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | default: 48 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 48 }}px;
  }
{%- endstyle -%}

<div class="video-feature-section section-{{ section.id }}-padding bg-surface">
  <div class="page-width mx-auto px-4 md:px-8 max-w-7xl">
    <div class="text-center max-w-3xl mx-auto mb-10">
      {%- if section.settings.eyebrow != blank -%}
        <span class="inline-block py-1 px-3 mb-3 text-xs font-black tracking-wider uppercase bg-cyan-100 text-cyan-800 rounded-full">
          {{ section.settings.eyebrow }}
        </span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight">
          {{ section.settings.heading }}
        </h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="mt-3 text-base md:text-lg text-slate-600">
          {{ section.settings.subheading }}
        </p>
      {%- endif -%}
    </div>

    <div class="relative rounded-3xl overflow-hidden shadow-2xl bg-slate-900 aspect-video max-w-5xl mx-auto border-4 border-white group">
      {%- if section.settings.video != blank -%}
        {{ section.settings.video | video_tag: 
          autoplay: section.settings.autoplay, 
          loop: section.settings.loop, 
          muted: section.settings.muted, 
          controls: true, 
          class: 'w-full h-full object-cover' 
        }}
      {%- else -%}
        <div class="relative w-full h-full flex items-center justify-center bg-gradient-to-tr from-slate-900 via-cyan-950 to-slate-900">
          <img 
            src="https://images.unsplash.com/photo-1519046904884-53103b34b206?q=80&w=1600&auto=format&fit=crop" 
            alt="SALD Outdoor Fun in Action" 
            class="absolute inset-0 w-full h-full object-cover opacity-60 transition-transform duration-700 group-hover:scale-105"
            loading="lazy"
          >
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-slate-950/20 to-transparent"></div>
          
          <div class="relative z-10 text-center px-6">
            <div class="w-20 h-20 md:w-24 md:h-24 mx-auto mb-4 rounded-full bg-cyan-400 text-slate-900 flex items-center justify-center shadow-lg shadow-cyan-400/40 transform transition-transform duration-300 group-hover:scale-110">
              <svg class="w-8 h-8 md:w-10 md:h-10 ml-1 fill-current" viewBox="0 0 24 24">
                <path d="M8 5v14l11-7z" />
              </svg>
            </div>
            <p class="text-white text-lg md:text-xl font-bold drop-shadow">Built for Non-Stop Backyard Memories</p>
            <p class="text-cyan-200 text-sm mt-1">Play • Splash • Enjoy — Guaranteed All-Season Durability</p>
          </div>
        </div>
      {%- endif -%}
    </div>

    <div class="mt-8 grid grid-cols-2 md:grid-cols-4 gap-4 max-w-4xl mx-auto text-center">
      <div class="p-4 rounded-2xl bg-white border border-slate-100 shadow-sm">
        <span class="block text-2xl font-black text-cyan-600">5-Min</span>
        <span class="text-xs font-semibold text-slate-600">Quick Tool-Free Assembly</span>
      </div>
      <div class="p-4 rounded-2xl bg-white border border-slate-100 shadow-sm">
        <span class="block text-2xl font-black text-amber-500">100%</span>
        <span class="text-xs font-semibold text-slate-600">UV &amp; Chlorine Proof</span>
      </div>
      <div class="p-4 rounded-2xl bg-white border border-slate-100 shadow-sm">
        <span class="block text-2xl font-black text-cyan-600">BPA-Free</span>
        <span class="text-xs font-semibold text-slate-600">Child-Safe Materials</span>
      </div>
      <div class="p-4 rounded-2xl bg-white border border-slate-100 shadow-sm">
        <span class="block text-2xl font-black text-amber-500">30-Day</span>
        <span class="text-xs font-semibold text-slate-600">Splash-Test Guarantee</span>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Video Feature",
  "tag": "section",
  "class": "section-video-feature",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow badge",
      "default": "SEE IT IN ACTION"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "See SALD in Real Action"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Watch families, resort guests, and competitive kids putting our games to the test"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Shopify-hosted video"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay video",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "loop",
      "label": "Loop video",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "muted",
      "label": "Mute sound by default",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Video Feature"
    }
  ]
}
{% endschema %}