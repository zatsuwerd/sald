<section class="sald-shop-by-activity py-16 lg:py-24 bg-slate-50" data-section-id="{{ section.id }}">
  <div class="max-w-[var(--page-width)] mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-2xl mx-auto mb-12">
      <h2 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight">{{ section.settings.title }}</h2>
      {%- if section.settings.subtitle != blank -%}
        <p class="mt-2 text-slate-600 font-medium text-base sm:text-lg">{{ section.settings.subtitle }}</p>
      {%- endif -%}
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link | default: '/collections/all' }}" 
           class="group relative rounded-3xl overflow-hidden bg-slate-900 text-white shadow-md hover:shadow-2xl transition-all duration-300 hover:-translate-y-1.5 flex flex-col justify-end p-8 min-h-[380px]"
           {{ block.shopify_attributes }}>
          
          <!-- Background image or gradient -->
          <div class="absolute inset-0 bg-slate-800">
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 900 }}" 
                   alt="{{ block.settings.title | escape }}" 
                   class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" 
                   loading="lazy" width="900" height="600">
            {%- else -%}
              <div class="w-full h-full bg-gradient-to-t from-slate-950 via-slate-900/60 to-cyan-800/40"></div>
            {%- endif -%}
          </div>

          <!-- Bottom gradient overlay -->
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/50 to-transparent"></div>

          <!-- Content -->
          <div class="relative z-10">
            {%- if block.settings.tag != blank -%}
              <span class="inline-block px-3 py-1 rounded-full bg-cyan-500 text-white font-extrabold text-[10px] uppercase tracking-wider mb-3">
                {{ block.settings.tag }}
              </span>
            {%- endif -%}

            <h3 class="text-2xl font-black text-white group-hover:text-cyan-300 transition-colors">
              {{ block.settings.title }}
            </h3>

            {%- if block.settings.description != blank -%}
              <p class="text-xs sm:text-sm text-slate-300 font-medium mt-2 leading-relaxed">
                {{ block.settings.description }}
              </p>
            {%- endif -%}

            <div class="mt-4 inline-flex items-center text-xs font-bold text-amber-400 group-hover:text-amber-300 gap-1.5">
              <span>View Collection</span>
              <svg class="w-4 h-4 transition-transform group-hover:translate-x-1 rtl:group-hover:-translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </div>
          </div>
        </a>
      {%- endfor -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Shop by Activity",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Shop by Activity"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subheading",
      "default": "Find the perfect gear matched to your outdoor environment"
    }
  ],
  "blocks": [
    {
      "type": "activity_card",
      "name": "Activity Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Category tag",
          "default": "Water Games"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Pool Party Chaos"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Volleyball sets, floating slam hoops, and dive-ring relay challenges."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by Activity",
      "category": "Collection"
    }
  ]
}
{% endschema %}