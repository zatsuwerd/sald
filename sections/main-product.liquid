<section class="sald-main-product py-12 lg:py-16 bg-white" data-section-id="{{ section.id }}">
  <div class="max-w-[var(--page-width)] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16">
      
      <!-- Left: Product Media Gallery -->
      <div class="space-y-4">
        <div class="aspect-square bg-slate-100 rounded-3xl overflow-hidden border border-slate-200/80 relative">
          {%- if product.featured_image != blank -%}
            <img src="{{ product.featured_image | image_url: width: 1200 }}" 
                 alt="{{ product.title | escape }}" 
                 class="w-full h-full object-cover" 
                 loading="eager" width="1200" height="1200">
          {%- else -%}
            <div class="w-full h-full flex items-center justify-center bg-cyan-50 text-cyan-600 font-extrabold text-2xl">
              SALD Pro Pool Gear
            </div>
          {%- endif -%}
        </div>
      </div>

      <!-- Right: Product Information -->
      <div class="lg:sticky lg:top-28 self-start space-y-6">
        <div>
          <div class="flex items-center gap-2 mb-2">
            <span class="text-xs font-black uppercase tracking-wider text-cyan-600">SALD Outdoor</span>
            <span class="text-slate-300">·</span>
            <div class="flex items-center text-amber-400 text-xs font-bold">
              ★★★★★ <span class="text-slate-600 ml-1">(4.9/5 · 142 reviews)</span>
            </div>
          </div>
          <h1 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight">{{ product.title | default: 'AquaSlam Floating Pool Basketball Set' }}</h1>
          
          <div class="flex items-center gap-3 mt-4">
            <span class="text-3xl font-black text-cyan-600" data-product-price>{{ product.price | default: 5999 | money }}</span>
            {%- if product.compare_at_price > product.price -%}
              <span class="text-lg text-slate-400 line-through">{{ product.compare_at_price | money }}</span>
              <span class="px-2 py-0.5 rounded-full bg-amber-100 text-amber-900 text-xs font-black uppercase">Save 20%</span>
            {%- endif -%}
          </div>
        </div>

        <!-- Stock Status & Trust -->
        <div class="flex items-center gap-2 text-xs font-bold text-emerald-700 bg-emerald-50 px-3 py-2 rounded-xl border border-emerald-200/60">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
          <span>In Stock · Ready to Ship within 24 Hours</span>
        </div>

        <!-- Add to cart form -->
        {% form 'product', product, class: 'space-y-4' %}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          
          <div class="flex items-center gap-4">
            <div class="flex items-center border border-slate-300 rounded-full px-4 py-2 bg-slate-50">
              <button type="button" class="text-slate-500 hover:text-slate-900 font-black text-base px-2">-</button>
              <input type="number" name="quantity" value="1" min="1" class="w-12 text-center bg-transparent font-bold text-slate-900 focus:outline-none">
              <button type="button" class="text-slate-500 hover:text-slate-900 font-black text-base px-2">+</button>
            </div>

            <button type="submit" class="flex-1 py-4 px-8 bg-cyan-500 hover:bg-cyan-600 text-white font-extrabold text-base rounded-full shadow-lg shadow-cyan-500/25 transition-transform hover:scale-[1.01] active:scale-[0.99]">
              Add to Cart
            </button>
          </div>
        {% endform %}

        <!-- Product Value Highlights Accordions -->
        <div class="border-t border-slate-200 pt-6 space-y-4">
          <details class="group py-2 border-b border-slate-100" open>
            <summary class="flex justify-between items-center cursor-pointer font-extrabold text-slate-900 text-sm">
              <span>Features &amp; Specifications</span>
              <span class="transition group-open:rotate-180">▼</span>
            </summary>
            <div class="mt-3 text-sm text-slate-600 space-y-2 leading-relaxed">
              <p>• Commercial-grade UV and chlorine-resistant polymers.</p>
              <p>• High-stability water-fillable base (holds up to 50 lbs of water).</p>
              <p>• Includes 2 pro-grip mini water basketballs + fast hand pump.</p>
            </div>
          </details>

          <details class="group py-2 border-b border-slate-100">
            <summary class="flex justify-between items-center cursor-pointer font-extrabold text-slate-900 text-sm">
              <span>Shipping &amp; 30-Day Splash Guarantee</span>
              <span class="transition group-open:rotate-180">▼</span>
            </summary>
            <div class="mt-3 text-sm text-slate-600 leading-relaxed">
              <p>Free standard delivery on orders over $75. Every SALD product is backed by our 30-day "Splash with Confidence" guarantee. If your family isn't 100% thrilled, return it hassle-free.</p>
            </div>
          </details>
        </div>

      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product Main",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_sticky_info",
      "label": "Enable sticky product info",
      "default": true
    }
  ]
}
{% endschema %}