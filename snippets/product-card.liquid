<div class="sald-product-card group relative bg-white rounded-2xl border border-slate-200/80 p-3 sm:p-4 flex flex-col justify-between hover:shadow-xl hover:border-cyan-300 transition-all duration-300">
  
  <!-- Top image container with badges and quick actions -->
  <div class="relative aspect-square rounded-xl overflow-hidden bg-slate-50 mb-4">
    <!-- Badges -->
    <div class="absolute top-2.5 left-2.5 z-10 flex flex-col gap-1.5">
      {%- if product.compare_at_price > product.price -%}
        <span class="px-2 py-0.5 rounded-full bg-amber-400 text-slate-950 font-black text-[10px] uppercase tracking-wider shadow-sm">
          Sale
        </span>
      {%- endif -%}
      {%- if product.tags contains 'bestseller' -%}
        <span class="px-2 py-0.5 rounded-full bg-cyan-500 text-white font-extrabold text-[10px] uppercase tracking-wider shadow-sm">
          Top Pick
        </span>
      {%- endif -%}
    </div>

    <!-- Wishlist button -->
    <button type="button" class="absolute top-2.5 right-2.5 z-10 p-2 rounded-full bg-white/80 backdrop-blur-sm text-slate-600 hover:text-rose-500 shadow-sm transition-colors" aria-label="Add to wishlist">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
    </button>

    <!-- Product Image -->
    <a href="{{ product.url }}" class="block w-full h-full">
      {%- if product.featured_image != blank -%}
        <img src="{{ product.featured_image | image_url: width: 600 }}" 
             alt="{{ product.title | escape }}" 
             class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" 
             loading="lazy" width="600" height="600">
      {%- else -%}
        <div class="w-full h-full flex items-center justify-center bg-cyan-50 text-cyan-600 font-bold text-sm">
          SALD Outdoors
        </div>
      {%- endif -%}
    </a>

    <!-- Quick View Trigger Overlay Button -->
    <button type="button" 
            class="absolute bottom-2.5 inset-x-2.5 py-2.5 bg-white/95 hover:bg-white text-slate-900 font-extrabold text-xs rounded-xl shadow-md backdrop-blur-sm opacity-0 translate-y-2 group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-200"
            data-quick-view="{{ product.id }}">
      Quick View
    </button>
  </div>

  <!-- Product Meta -->
  <div class="flex-1 flex flex-col justify-between">
    <div>
      <div class="flex items-center text-amber-400 text-xs mb-1">
        ★★★★★ <span class="text-slate-400 font-bold ml-1">(4.9)</span>
      </div>
      <h3 class="font-extrabold text-slate-900 text-sm sm:text-base leading-snug group-hover:text-cyan-600 transition-colors line-clamp-2">
        <a href="{{ product.url }}">{{ product.title }}</a>
      </h3>
    </div>

    <div class="mt-3 pt-3 border-t border-slate-100 flex items-center justify-between gap-2">
      <div class="flex items-baseline gap-1.5">
        <span class="text-base sm:text-lg font-black text-cyan-600">{{ product.price | money }}</span>
        {%- if product.compare_at_price > product.price -%}
          <span class="text-xs text-slate-400 line-through">{{ product.compare_at_price | money }}</span>
        {%- endif -%}
      </div>

      <!-- Quick Add 1-Click Button -->
      <button type="button" 
              class="px-3 py-1.5 bg-slate-900 hover:bg-cyan-500 text-white rounded-lg font-extrabold text-xs transition-colors active:scale-95"
              data-quick-add="{{ product.selected_or_first_available_variant.id }}"
              aria-label="Add to cart">
        + Add
      </button>
    </div>
  </div>

</div>