{%- liquid
  assign aspect_ratio = settings.card_image_ratio | default: 'square'
  case aspect_ratio
    when 'portrait'
      assign ratio_class = 'aspect-[3/4]'
    when 'landscape'
      assign ratio_class = 'aspect-[4/3]'
    else
      assign ratio_class = 'aspect-square'
  endcase

  assign show_vendor = settings.card_show_vendor | default: false
  assign show_rating = settings.card_show_rating
  if show_rating == nil
    assign show_rating = true
  endif
  assign show_sale_badge = settings.card_show_sale_badge
  if show_sale_badge == nil
    assign show_sale_badge = true
  endif
  assign enable_quick_add = settings.card_enable_quick_add
  if enable_quick_add == nil
    assign enable_quick_add = true
  endif
  assign enable_quick_view = settings.card_enable_quick_view
  if enable_quick_view == nil
    assign enable_quick_view = true
  endif
  assign show_secondary_image = settings.card_show_secondary_image
  if show_secondary_image == nil
    assign show_secondary_image = true
  endif
-%}

<div class="sald-product-card group relative bg-white rounded-2xl border border-slate-200/80 p-3 sm:p-4 flex flex-col justify-between hover:shadow-xl hover:border-cyan-300 transition-all duration-300"
     style="border-radius: var(--card-radius, 16px); background-color: var(--color-surface, #FFFFFF); border-color: var(--color-border, #E2E8F0);">
  
  <!-- Top image container with badges and quick actions -->
  <div class="relative {{ ratio_class }} rounded-xl overflow-hidden bg-slate-50 mb-4"
       style="border-radius: calc(var(--card-radius, 16px) - 4px);">
    <!-- Badges -->
    <div class="absolute top-2.5 left-2.5 z-10 flex flex-col gap-1.5 pointer-events-none">
      {%- if show_sale_badge and product.compare_at_price > product.price -%}
        <span class="px-2 py-0.5 rounded-full text-slate-950 font-black text-[10px] uppercase tracking-wider shadow-sm"
              style="background-color: var(--color-badge-sale, #FBBF24);">
          Sale
        </span>
      {%- endif -%}
      {%- if product.tags contains 'bestseller' or product.tags contains 'featured' -%}
        <span class="px-2 py-0.5 rounded-full text-white font-extrabold text-[10px] uppercase tracking-wider shadow-sm"
              style="background-color: var(--color-secondary, #00C2CB);">
          Top Pick
        </span>
      {%- endif -%}
    </div>

    <!-- Wishlist button -->
    <button type="button" class="absolute top-2.5 right-2.5 z-10 p-2 rounded-full bg-white/80 backdrop-blur-sm text-slate-600 hover:text-rose-500 shadow-sm transition-colors" aria-label="Add to wishlist">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
    </button>

    <!-- Product Image -->
    <a href="{{ product.url }}" class="block w-full h-full relative overflow-hidden">
      {%- if product.featured_image != blank -%}
        <img src="{{ product.featured_image | image_url: width: 600 }}" 
             alt="{{ product.title | escape }}" 
             class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105 {% if show_secondary_image and product.images.size > 1 %}group-hover:opacity-0 transition-opacity{% endif %}" 
             loading="lazy" width="600" height="600">
        {%- if show_secondary_image and product.images.size > 1 -%}
          <img src="{{ product.images[1] | image_url: width: 600 }}" 
               alt="{{ product.title | escape }}" 
               class="absolute inset-0 w-full h-full object-cover opacity-0 group-hover:opacity-100 transition-all duration-500 group-hover:scale-105" 
               loading="lazy" width="600" height="600">
        {%- endif -%}
      {%- else -%}
        <div class="w-full h-full flex items-center justify-center bg-cyan-50 text-cyan-600 font-bold text-sm">
          SALD Outdoors
        </div>
      {%- endif -%}
    </a>

    <!-- Quick View Trigger Overlay Button -->
    {%- if enable_quick_view -%}
      <button type="button" 
              class="absolute bottom-2.5 inset-x-2.5 py-2.5 bg-white/95 hover:bg-white text-slate-900 font-extrabold text-xs shadow-md backdrop-blur-sm opacity-0 translate-y-2 group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-200"
              style="border-radius: var(--btn-radius, 24px);"
              data-quick-view="{{ product.id }}">
        Quick View
      </button>
    {%- endif -%}
  </div>

  <!-- Product Meta -->
  <div class="flex-1 flex flex-col justify-between">
    <div>
      {%- if show_vendor and product.vendor != blank -%}
        <p class="text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-1">{{ product.vendor }}</p>
      {%- endif -%}

      {%- if show_rating -%}
        <div class="flex items-center text-amber-400 text-xs mb-1">
          ★★★★★ <span class="text-slate-400 font-bold ml-1">(4.9)</span>
        </div>
      {%- endif -%}

      <h3 class="font-extrabold text-slate-900 text-sm sm:text-base leading-snug hover:text-cyan-600 transition-colors line-clamp-2"
          style="color: var(--color-headings, #0F172A);">
        <a href="{{ product.url }}">{{ product.title }}</a>
      </h3>
    </div>

    <div class="mt-3 pt-3 border-t border-slate-100 flex items-center justify-between gap-2"
         style="border-color: var(--color-border, #E2E8F0);">
      <div class="flex items-baseline gap-1.5">
        <span class="text-base sm:text-lg font-black text-cyan-600" style="color: var(--color-secondary, #00C2CB);">
          {{ product.price | money }}
        </span>
        {%- if product.compare_at_price > product.price -%}
          <span class="text-xs text-slate-400 line-through">{{ product.compare_at_price | money }}</span>
        {%- endif -%}
      </div>

      <!-- Quick Add 1-Click Button -->
      {%- if enable_quick_add -%}
        <button type="button" 
                class="px-3.5 py-1.5 text-white font-extrabold text-xs transition-colors active:scale-95 sald-btn"
                style="background-color: var(--color-button-bg, #00C2CB); color: var(--color-button-text, #FFFFFF); border-radius: var(--btn-radius, 24px);"
                data-quick-add="{{ product.selected_or_first_available_variant.id }}"
                aria-label="Add to cart">
          + Add
        </button>
      {%- endif -%}
    </div>
  </div>

</div>